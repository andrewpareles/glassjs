{
  "name": "glassjs",
  "icon": "/images/a3.png",
  "publisher": "glassjs",
  "displayName": "Glass",
  "description": "",
  "version": "1.3.8",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "glassjs.debug",
        "title": "Debug Glass"
      }
    ],
    "configuration": {
      "title": "Glass",
      "properties": {
        "glass.openAiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key"
        },
        "glass.openAiModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "OpenAI Model (defaults to 4o, must be of type OpenAI.Chat.ChatModel)"
        },
        "glass.telemetry": {
          "type": "boolean",
          "default": "false",
          "description": "Whether to send telemetry"
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.6",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.89.0",
    "@types/ws": "^8.5.11",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "history": "^5.3.0",
    "lodash": "^4.17.21",
    "openai": "^4.52.7",
    "posthog-js": "^1.148.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  }
}